# Local API settings
APP_NAME=Evidence Intelligence API
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/evidence.db

# Local sentence-transformer; the model downloads on first use.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenAI-compatible chat endpoint.
# OpenRouter example: https://openrouter.ai/api/v1
# Ollama example: http://localhost:11434/v1 (set API key to ollama)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_api_key_here
LLM_MODEL=openrouter/free
LLM_TIMEOUT_SECONDS=90

# Retrieval settings
RETRIEVAL_TOP_K=6
MIN_RELEVANCE_SCORE=0.22
CHUNK_WORDS=220
CHUNK_OVERLAP_WORDS=40
MAX_UPLOAD_MB=20
