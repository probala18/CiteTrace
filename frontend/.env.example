# API routing (Use /api for serverless routes, or http://localhost:8000/api for python backend)
NEXT_PUBLIC_API_URL=/api

# LLM & Embeddings (OpenRouter / OpenAI compatible)
OPENAI_API_KEY=your_openrouter_or_openai_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free

# Database (Optional for production persistence across cold starts; defaults to local/temp SQLite)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token